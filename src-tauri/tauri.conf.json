{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aulactl",
  "version": "0.3.0",
  "identifier": "app.aulactl.desktop",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3150",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aulactl",
        "width": 1200,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 640,
        "zoomHotkeysEnabled": true,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
